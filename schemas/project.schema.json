{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSV to FCPXML project",
  "type": "object",
  "properties": {
    "event_name": {"type": "string"},
    "project_name": {"type": "string"},
    "output_basename": {"type": "string"},
    "fcpxml_version": {"const": "1.14"},
    "width": {"type": "integer", "minimum": 2},
    "height": {"type": "integer", "minimum": 2},
    "fps": {"type": ["string", "number"]},
    "color_space": {"type": "string"},
    "audio_rate": {"enum": ["32k", "44.1k", "48k", "88.2k", "96k", "176.4k", "192k"]},
    "timeline_csv": {"type": "string", "minLength": 1},
    "media_dir": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "path_mode": {"enum": ["absolute", "relative"]},
    "image_mode": {"enum": ["video-cache", "direct"]},
    "image_background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "bgm": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": {"type": "string"},
            "timeline_start": {"type": ["string", "number"]},
            "source_in": {"type": ["string", "number"]},
            "duration": {"type": ["string", "number"]},
            "timeline_end": {"type": ["string", "number"]},
            "volume_db": {"type": "number"},
            "role": {"type": "string"}
          }
        }
      ]
    },
    "subtitles": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "file": {"type": "string"},
            "mode": {"enum": ["title", "caption", "both", "off"]},
            "srt": {"type": ["boolean", "string", "number"]},
            "write_srt": {"type": ["boolean", "string", "number"]},
            "role": {"type": "string"},
            "font": {"type": "string", "minLength": 1},
            "font_size": {"type": "number", "exclusiveMinimum": 0},
            "font_face": {"type": "string"},
            "position_x": {"type": "number"},
            "position_y": {"type": "number"},
            "position_x_percent": {"type": "number"},
            "position_y_percent": {"type": "number"},
            "alignment": {"enum": ["left", "center", "right", "justified"]},
            "outline_color": {"type": "string"},
            "outline_width": {"type": "number", "minimum": -100, "maximum": 100},
            "shadow": {"type": ["boolean", "string", "number"]},
            "shadow_color": {"type": "string"},
            "shadow_offset": {"type": "string"},
            "shadow_blur_radius": {"type": "number", "minimum": 0},
            "title_effect_uid": {"type": "string", "minLength": 1},
            "format": {"enum": ["ITT", "itt"]},
            "language": {"type": "string"},
            "placement": {"enum": ["top", "bottom"]},
            "prefix": {"type": "string"},
            "speaker_label": {"type": "string"},
            "wrap_width": {"type": "integer", "minimum": 8},
            "prefix_color": {"type": "string"},
            "body_color": {"type": "string"},
            "background_color": {"type": "string"},
            "bold": {"type": ["boolean", "string", "number"]}
          }
        }
      ]
    },
    "captions": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "file": {"type": "string"},
            "embed": {"type": ["boolean", "string", "number"]},
            "format": {"enum": ["ITT", "itt"]},
            "role": {"type": "string"},
            "language": {"type": "string"},
            "placement": {"enum": ["top", "bottom"]},
            "prefix": {"type": "string"},
            "wrap_width": {"type": "integer", "minimum": 8},
            "prefix_color": {"type": "string"},
            "body_color": {"type": "string"},
            "background_color": {"type": "string"},
            "bold": {"type": ["boolean", "string", "number"]}
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
